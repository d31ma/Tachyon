{
  "name": "@d31ma/tachyon",
  "version": "26.36.01",
  "description": "Tooling and qualification dependencies for the Tachyon Rust framework",
  "author": "Chidelma",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc -p jsconfig.json --noEmit && tsc -p jsconfig.release.json --noEmit",
    "test:website": "bun --cwd website test",
    "test:website-browser": "node scripts/website-browser-test.mjs",
    "test:rust-browser": "node scripts/phase3-browser-test.mjs",
    "test:rust-hmr": "node scripts/hot-update-browser-test.mjs",
    "test:rust-macos": "node scripts/phase4-macos-test.mjs",
    "test:compat": "node scripts/compat/differential.mjs",
    "test:rust-standalone": "node scripts/compat/standalone-rust.mjs",
    "test:rust-events": "node scripts/events-browser-test.mjs",
    "test:rust-offline": "node scripts/service-worker-browser-test.mjs",
    "test:rust-client": "node scripts/island-expression-test.mjs",
    "test:rust-runtime": "node scripts/runtime-browser-test.mjs",
    "test:rust-storage": "node scripts/storage-browser-test.mjs",
    "test:native-companion": "node scripts/native/companion-test.mjs"
  },
  "keywords": [
    "tachyon",
    "rust",
    "framework",
    "api",
    "polyglot",
    "file-system-routing",
    "native-ui",
    "web-framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d31ma/Tachyon.git"
  },
  "homepage": "https://tachyon.del.ma",
  "bugs": {
    "url": "https://github.com/d31ma/Tachyon/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^20.4.2",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2"
  }
}
