{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tachyon.del.ma/schema/route-manifest/v1",
  "title": "Tachyon Route Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "routes"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context",
          "handlers",
          "kind",
          "methods",
          "parameters",
          "route",
          "view"
        ],
        "properties": {
          "route": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 2048
          },
          "kind": {
            "enum": [
              "page",
              "api"
            ]
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "DELETE",
                "GET",
                "HEAD",
                "OPTIONS",
                "PATCH",
                "POST",
                "PUT"
              ]
            }
          },
          "view": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "handlers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "language",
                "runtime"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[^/\\\\][^\\\\]*$",
                  "maxLength": 512
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_+-]{0,31}$"
                },
                "runtime": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
                }
              }
            }
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "collision_policy",
              "static_exports",
              "response_exports"
            ],
            "properties": {
              "collision_policy": {
                "const": "error"
              },
              "static_exports": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                }
              },
              "response_exports": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                }
              }
            }
          },
          "parameters": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "maxLength": 64
            }
          }
        }
      }
    }
  }
}
