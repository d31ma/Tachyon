{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tachyon.del.ma/schema/artifact-manifest/v1",
  "title": "Tachyon Artifact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "release_version",
    "commit",
    "source_date_epoch",
    "target",
    "toolchains",
    "contracts",
    "outputs"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "release_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "abi"],
      "properties": {
        "os": {
          "enum": ["linux", "macos", "windows", "android", "ios"]
        },
        "architecture": {
          "enum": ["x86_64", "aarch64", "universal"]
        },
        "abi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "toolchains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_manifest",
        "diagnostics",
        "handler_protocol",
        "route_manifest",
        "view_ir"
      ],
      "properties": {
        "artifact_manifest": { "const": 1 },
        "capability_manifest": { "const": 1 },
        "diagnostics": { "const": 1 },
        "handler_protocol": { "const": 1 },
        "native_ui": { "const": 1 },
        "native_host": { "const": 3 },
        "route_manifest": { "const": 1 },
        "view_ir": { "const": 1 }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\][^\\\\]*$",
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
