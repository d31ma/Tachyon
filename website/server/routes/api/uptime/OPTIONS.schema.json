{
  "summary": "Python runtime and request-process uptime",
  "methods": {
    "GET": {
      "summary": "The framework-owned Python runtime and elapsed time in this request process",
      "ok": {
        "language": "^.{1,40}$",
        "version": "^[0-9][0-9A-Za-z.+-]{0,30}$",
        "uptimeSeconds": "^[0-9]+(\\.[0-9]+)?$"
      }
    }
  }
}
